[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="Font"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "SimHei")

[sub_resource type="StyleBoxFlat" id="Paper"]
bg_color = Color(0.89, 0.82, 0.65, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.34, 0.24, 0.18, 1)
shadow_color = Color(0.19, 0.15, 0.12, 0.3)
shadow_size = 1
shadow_offset = Vector2(0, 1)
content_margin_left = 5.0
content_margin_top = 3.0
content_margin_right = 5.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="Slot"]
bg_color = Color(0.66, 0.49, 0.32, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.38, 0.25, 0.18, 1)

[sub_resource type="StyleBoxFlat" id="Selected"]
bg_color = Color(0.95, 0.85, 0.59, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.95, 0.76, 1)

[sub_resource type="StyleBoxEmpty" id="Empty"]

[sub_resource type="StyleBoxFlat" id="Hover"]
bg_color = Color(0.79, 0.64, 0.43, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.95, 0.85, 0.59, 1)

[resource]
default_font = SubResource("Font")
default_font_size = 7
Label/colors/font_color = Color(0.29, 0.21, 0.16, 1)
PanelContainer/styles/panel = SubResource("Paper")
InventoryDetails/base_type = &"PanelContainer"
InventoryDetails/styles/panel = SubResource("Paper")
InventorySlot/styles/idle = SubResource("Slot")
InventorySlot/styles/selected = SubResource("Selected")
InventorySlot/styles/hover = SubResource("Hover")
Button/styles/normal = SubResource("Empty")
Button/styles/hover = SubResource("Selected")
Button/styles/pressed = SubResource("Selected")
Button/styles/focus = SubResource("Empty")
Button/colors/font_color = Color(0.29, 0.21, 0.16, 1)

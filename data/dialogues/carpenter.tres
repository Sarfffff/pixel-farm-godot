[resource]
script = ExtResource("1_dialogue")
lines = Array[String](["木头别乱丢，攒起来能换东西。", "你那把斧头我看过了，砍小树两下、大树三下，别硬来。", "等社区那边开工，我给你打一套像样的家具。"])

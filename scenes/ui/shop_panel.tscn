[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/panels/shop_panel.gd" id="1_shop"]
[ext_resource type="Theme" path="res://assets/ui/farm_hud.tres" id="2_theme"]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "SimHei")

[node name="ShopPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

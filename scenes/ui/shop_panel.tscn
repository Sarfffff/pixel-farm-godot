anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.06, 0.05, 0.04, 0.4)

[node name="Frame" type="PanelContainer" parent="."]
layout_mode = 1

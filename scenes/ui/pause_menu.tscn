[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://assets/generated/ui/inventory/inventory_theme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "SimHei")

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_pause")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.05, 0.05, 0.07, 0.6)

[node name="Frame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -78.0
offset_top = -58.0
offset_right = 78.0
offset_bottom = 58.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Frame"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Frame/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.91, 0.74, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 9
text = "游戏暂停"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.74, 0.56, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 7
text = "我的农场 · 第 1 天"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 3

[node name="ContinueButton" type="Button" parent="Frame/VBox/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.88, 0.68, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 8
text = "继续游戏"

[node name="SaveButton" type="Button" parent="Frame/VBox/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.88, 0.68, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 8
text = "保存游戏"

[node name="TitleButton" type="Button" parent="Frame/VBox/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.88, 0.68, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 8
text = "保存并返回标题"

[node name="HelpButton" type="Button" parent="Frame/VBox/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.88, 0.68, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 8
text = "按键说明"

[node name="Hint" type="Label" parent="Frame/VBox"]
unique_name_in_owner = true

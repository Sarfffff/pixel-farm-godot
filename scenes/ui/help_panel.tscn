[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/help_panel.gd" id="1_help"]
[ext_resource type="Theme" path="res://assets/generated/ui/inventory/inventory_theme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "SimHei")

[node name="HelpPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_help")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.05, 0.05, 0.07, 0.6)

[node name="Frame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -122.0
offset_top = -74.0
offset_right = 122.0
offset_bottom = 74.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Frame"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Frame/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.91, 0.74, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 9
text = "按键说明"
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="Hint" type="Label" parent="Frame/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.74, 0.56, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 7
text = "F1 / Esc 关闭"
horizontal_alignment = 1

[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/day_summary.gd" id="1_summary"]
[ext_resource type="Theme" path="res://assets/generated/ui/inventory/inventory_theme.tres" id="2_theme"]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans CJK SC", "SimHei")

[node name="DaySummary" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_summary")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.05, 0.05, 0.07, 0.55)

[node name="Frame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -104.0
offset_top = -54.0
offset_right = 104.0
offset_bottom = 54.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Frame"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.91, 0.74, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 9
text = "第 1 天结束"
horizontal_alignment = 1

[node name="Lines" type="Label" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.88, 0.82, 0.66, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 7
text = "今日收获 0 件 · 今日收入 0 金币"
horizontal_alignment = 1
autowrap_mode = 3

[node name="SleepButton" type="Button" parent="Frame/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0.96, 0.91, 0.74, 1)
theme_override_colors/font_hover_color = Color(1, 0.96, 0.82, 1)
theme_override_colors/font_pressed_color = Color(1, 0.96, 0.82, 1)
theme_override_fonts/font = SubResource("SystemFont_ui")
theme_override_font_sizes/font_size = 8
theme_type_variation = &"InventoryDetails"
text = "睡觉 · 进入下一天"

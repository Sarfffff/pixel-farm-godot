# Godot 4+ specific ignores
.godot/
/android/

# 导出产物（export_presets.cfg 是发布配置、不含密钥，必须入库）
export.cfg
*.translation
/build/

# 回归/预览截图（脚本输出目录，不入库）
/docs/screenshots/

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log

# 临时诊断脚本（下划线开头）：只是本地跑一次的小工具，不进仓库
/tools/_*.gd
/tools/_*.gd.uid
/tools/check/_*.gd
/tools/check/_*.gd.uid
/tools/build/_*.gd
/tools/build/_*.gd.uid
